# Server
APP_NAME=Admin-Dashboard
APP_KEY=your_secure_random_app_key_32_characters_long
APP_IP=127.0.0.1
APP_DOMAIN=example.com
APP_PORT=3000
APP_BASE_URL=https://example.com

# Assets
ASSET_IP=127.0.0.1
ASSET_DOMAIN=example.com
ASSET_PORT=3000
ASSET_BASE_URL=https://example.com

# Database
DB_CONNECTION=mysql
DB_RECORD_NOT_FOUND_MESSAGE="record not found"

# MySQL config
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=admin_dashboard
DB_USERNAME=admin_user
DB_PASSWORD=your_strong_database_password

# Mailer (smtp, sendgrid, ses)
MAIL_DRIVER=smtp
MAIL_SENDER_NAME="Admin Dashboard"

# SMTP config
MAIL_SMTP_HOST=smtp.mailgun.org
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME="postmaster@yourdomain.com"
MAIL_SMTP_PASSWORD="your_smtp_password"
MAIL_SMTP_FROM=no-reply@yourdomain.com

# SendGrid config
MAIL_SENDGRID_API_KEY=SG.your_api_key_here
MAIL_SENDGRID_FROM=no-reply@yourdomain.com

# Amazon SES config
MAIL_AWS_REGION=us-east-1
MAIL_SES_FROM=no-reply@yourdomain.com

# Web Cookie Details
WEB_COOKIE_NAME=_admin_session
WEB_COOKIE_DOMAIN=example.com
WEB_COOKIE_PATH=/
WEB_COOKIE_MAX_AGE=3600
WEB_COOKIE_SECURE=true
WEB_COOKIE_HTTP_ONLY=true
WEB_COOKIE_SAME_SITE=strict
WEB_CSRF_TOKEN_LOOKUP=header:X-CSRF-Token,form:_csrf
WEB_CSRF_TOKEN_LENGTH=32

# Web Security
WEB_SECURE_XSS="1; mode=block"
WEB_SECURE_NOSNIFF=nosniff
WEB_SECURE_FRAME_OPTIONS=DENY
WEB_CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
WEB_SECURE_HSTS_MAX_AGE=63072000
WEB_SECURE_HSTS_SUBDOMAIN=false
WEB_SECURE_HSTS_PRELOAD=true
WEB_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
WEB_CSP_REPORT_ONLY=false

# Web Rate Limit
WEB_RATE_LIMIT=60

# Storage System: local or aws-s3
FILE_SYSTEM=local
FILE_SYSTEM_LOCATION=./storage/uploads
FILE_BACKUP_LOCATION=./storage/backup

# AWS S3 (if FILE_SYSTEM=aws-s3)
FILE_SYSTEM_AWS_REGION=ap-southeast-1
FILE_SYSTEM_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# Verification Token
VERIFICATION_TOKEN_LENGTH=4
VERIFICATION_TOKEN_EXPIRE_MINUTE=10

# Password Reset Token
PASSWORD_RESET_TOKEN_LENGTH=4
PASSWORD_RESET_TOKEN_EXPIRE_MINUTE=15

# Cache Driver: file, redis
CACHE_DRIVER=file
CACHE_PATH=storage/cache
CACHE_TIME=60

# Redis Cache (if CACHE_DRIVER=redis or SESSION_DRIVER=redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Session Driver: file, database, redis, cookie
SESSION_DRIVER=database
SESSION_PATH=storage/sessions
SESSION_TABLE=sessions
SESSION_LIFETIME=120

# Queue Worker Config
QUEUE_WORKER_INTERVAL=5
QUEUE_WORKER_BATCH_SIZE=50
QUEUE_WORKER_MAX_TRIES=5
