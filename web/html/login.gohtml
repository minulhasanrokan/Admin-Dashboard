<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
        <meta name="_csrf" content="{{ ._csrf }}">
        <title>Login | {{.SystemSetting.Name}} - {{.SystemSetting.Title}}</title>
        <link rel="shortcut icon" type="image/x-icon" href="{{.ConfigData.AppBaseUrl}}/file/system/{{.SystemSetting.Icon}}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{.ConfigData.AppBaseUrl}}/file/system/{{.SystemSetting.AppleIcon}}">
        <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/css/bootstrap.min.css">
        <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/plugins/icons/feather/feather.css">
        <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/plugins/tabler-icons/tabler-icons.min.css">
        <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/plugins/fontawesome/css/fontawesome.min.css">
        <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/plugins/fontawesome/css/all.min.css">
        <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/css/style.css">
        <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/css/common.css">
    </head>
    <body class="bg-white">
        {{ template "include/loader" . }}
        <div class="main-wrapper">
            <div class="container-fluid">
                <div class="w-100 overflow-hidden position-relative flex-wrap d-block vh-100">
                    <div class="row">
                        <div class="col-lg-5">
                            <div class="d-lg-flex align-items-center justify-content-center d-none flex-wrap vh-100 bg-primary-transparent">
                                <div>
                                    <img src="{{.ConfigData.AssetBaseUrl}}/file/system/{{.SystemSetting.LoginBg}}" alt="{{.SystemSetting.Name}}">
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-7 col-md-12 col-sm-12">
                            <div class="row justify-content-center align-items-center vh-100 overflow-auto flex-wrap ">
                                <div class="col-md-7 mx-auto vh-100">
                                    <form action="#" class="vh-100">
                                        <div class="vh-100 d-flex flex-column justify-content-between p-4 pb-0">
                                            <div class=" mx-auto mb-5 text-center">
                                                <img src="{{.ConfigData.AssetBaseUrl}}/file/system/{{.SystemSetting.Logo}}" alt="{{.SystemSetting.Name}}">
                                            </div>
                                            <div class="">
                                                <div class="text-center mb-3">
                                                    <h2 class="mb-2">Sign In</h2>
                                                    <p class="mb-0">Please enter your details to sign in</p>
                                                </div>
                                                {{if and .AuthSetting (eq .AuthSetting.LoginType "mobile")}}
                                                <div class="mb-3">
                                                    <label class="form-label">Mobile Number</label>
                                                    <div class="input-group">
                                                        <input autocomplete="off" type="text" tabindex="1" name="mobile" minlength="5" maxlength="20" id="mobile" value="" class="form-control" placeholder="Enter your mobile number">
                                                        <span class="input-group-text border-start-0">
                                                            <i class="ti ti-phone"></i>
                                                        </span>
                                                    </div>
                                                    <div class="invalid-feedback" id="error_msg_mobile"></div>
                                                </div>
                                                {{else}}
                                                <div class="mb-3">
                                                    <label class="form-label">Email Address</label>
                                                    <div class="input-group">
                                                        <input autocomplete="off" type="text" tabindex="1" name="email" minlength="5" maxlength="100" id="email" value="" class="form-control" placeholder="Enter your email">
                                                        <span class="input-group-text border-start-0">
                                                            <i class="ti ti-mail"></i>
                                                        </span>
                                                    </div>
                                                    <div class="invalid-feedback" id="error_msg_email"></div>
                                                </div>
                                                {{end}}

                                                {{if or (not .AuthSetting) .AuthSetting.PasswordRequired}}
                                                <div class="mb-3">
                                                    <label class="form-label">Password</label>
                                                    <div class="input-group">
                                                        <input autocomplete="off" type="password" tabindex="2" name="password" minlength="{{.UserRole.PasswordMinLength}}" maxlength="{{.UserRole.PasswordMaxLength}}" id="password" value="" class="form-control" placeholder="Enter your password">
                                                        <span class="input-group-text border-start-0">
                                                            <i id="eye_btn_password" class="ti ti-eye-off"></i>
                                                        </span>
                                                    </div>
                                                    <div class="invalid-feedback" id="error_msg_password"></div>
                                                </div>
                                                {{end}}
                                                <div class="d-flex align-items-center justify-content-between mb-3">
                                                    <div class="d-flex align-items-center">
                                                        <div class="form-check form-check-md mb-0">
                                                            <input autocomplete="off" class="form-check-input" tabindex="3" name="remember_me" id="remember_me" type="checkbox">
                                                            <label for="remember_me" class="form-check-label text-dark mt-0">Remember Me</label>
                                                            <div class="invalid-feedback" id="error_msg_remember_me"></div>
                                                        </div>
                                                    </div>
                                                    {{if or (not .AuthSetting) .AuthSetting.PasswordRequired}}
                                                    <div class="text-end">
                                                        <a href="{{.ConfigData.AppBaseUrl}}/user-password/forgot-password" class="link-danger">Forgot Password?</a>
                                                    </div>
                                                    {{end}}
                                                </div>
                                                <div class="mb-3">
                                                    <button type="button" tabindex="4" id="login_button" class="btn btn-primary w-100">Sign In</button>
                                                </div>
                                                {{if or (not .AuthSetting) .AuthSetting.AllowRegistration}}
                                                <div class="text-center">
                                                    <h6 class="fw-normal text-dark mb-0">Don’t have an account?
                                                        <a href="{{.ConfigData.AppBaseUrl}}/user-registration/create-account" class="hover-a"> Create Account</a>
                                                    </h6>
                                                </div>
                                                {{end}}
                                            </div>
                                            <div class="mt-5 pb-4 text-center">
                                                <p class="mb-0 text-gray-9">{{.SystemSetting.CopyRight}}</p>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/jquery-3.7.1.min.js"></script>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/axios.min.js"></script>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/bootstrap.bundle.min.js"></script>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/feather.min.js"></script>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/script.js"></script>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/notify.js"></script>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/config.js"></script>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/common.js"></script>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/form_validation.js"></script>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/user/login.js"></script>
    </body>
</html>