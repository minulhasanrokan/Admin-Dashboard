<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="_csrf" content="{{ ._csrf }}">
    <meta name="system_name" content="{{.SystemSetting.Name}}">
    <meta name="activity_list" content="{{.ActivityList}}">
    <meta name="process_status_list" content="{{.ProcessStatusList}}">
    <meta name="data_active_status_list" content="{{.DataActiveStatusList}}">
    <meta name="super_admin_status" content="{{.SessionData.SuperAdmin}}">
    <title>Dashboard | {{.SystemSetting.Name}} - {{.SystemSetting.Title}}</title>
    <link rel="shortcut icon" type="image/x-icon" href="{{.ConfigData.AppBaseUrl}}/file/system/{{.SystemSetting.Icon}}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{.ConfigData.AppBaseUrl}}/file/system/{{.SystemSetting.AppleIcon}}">
    <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/theme-script.js"></script>
    <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/plugins/icons/feather/feather.css">
    <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/plugins/tabler-icons/tabler-icons.min.css">
    <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/plugins/select2/css/select2.min.css">
    <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/plugins/fontawesome/css/fontawesome.min.css">
    <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/plugins/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/plugins/sweetalert2/sweetalert2.min.css">
    <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/css/bootstrap-datetimepicker.min.css">
    <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/plugins/bootstrap-tagsinput/bootstrap-tagsinput.css">
    <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/plugins/summernote/summernote-lite.min.css">
    <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/plugins/daterangepicker/daterangepicker.css">
    <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/plugins/flatpickr/flatpickr.min.css">
    <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/css/ag-grid.min.css">
    <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/css/ag-theme-quartz.min.css">
    <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/css/style.css">
    <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/css/common.css">
</head>
<body>
{{ template "include/loader" . }}
<div class="main-wrapper">
    {{ template "include/dashboard/header" . }}
    {{ template "include/dashboard/sidebar" . }}
    {{ template "include/dashboard/horizontal-menu" . }}
    {{ template "include/dashboard/two-col-sidebar" . }}
    {{ template "include/dashboard/stacked-sidebar" . }}
    <div class="page-wrapper">
        <div class="content" id="content">
            <div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">
                <div class="my-auto mb-2">
                    <h2 class="mb-1">Dashboard</h2>
                    <nav>
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a href="{{.ConfigData.AppBaseUrl}}/dashboard"><i class="ti ti-smart-home"></i></a>
                            </li>
                            <li class="breadcrumb-item">
                                Dashboard
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">Admin Dashboard</li>
                        </ol>
                    </nav>
                </div>
                <div class="d-flex my-xl-auto right-content align-items-center flex-wrap ">
                    <div class="me-2 mb-2">
                        <div class="dropdown">
                            <a href="#"
                               class="dropdown-toggle btn btn-white d-inline-flex align-items-center"
                               data-bs-toggle="dropdown">
                                <i class="ti ti-file-export me-1"></i>Export
                            </a>
                            <ul class="dropdown-menu  dropdown-menu-end p-3">
                                <li>
                                    <a href="#" class="dropdown-item rounded-1"><i
                                                class="ti ti-file-type-pdf me-1"></i>Export as PDF</a>
                                </li>
                                <li>
                                    <a href="#" class="dropdown-item rounded-1"><i
                                                class="ti ti-file-type-xls me-1"></i>Export as Excel </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="mb-2">
                        <div class="input-icon w-100 position-relative">
                                        <span class="input-icon-addon">
                                            <i class="ti ti-calendar text-gray-9"></i>
                                        </span>
                            <input type="text" class="form-control yearpicker" value="2025">
                        </div>
                    </div>
                    <div class="ms-2 mb-2 head-icons">
                        <a href="#" class="" data-bs-toggle="tooltip" data-bs-placement="top"
                           data-bs-original-title="Collapse" id="collapse-header">
                            <i class="ti ti-chevrons-up"></i>
                        </a>
                    </div>
                </div>
            </div>
            <!-- /Breadcrumb -->

            <!-- Welcome Wrap -->
            <div class="card border-0">
                <div class="card-body d-flex align-items-center justify-content-between flex-wrap pb-1">
                    <div class="d-flex align-items-center mb-3">
                        <span class="avatar avatar-xl flex-shrink-0">
                            {{if .SessionData.Photo}}
                                <img src="{{.ConfigData.AppBaseUrl}}/file/user/{{.SessionData.Photo}}" class="rounded-circle" alt="{{.SessionData.UserName}}">
                            {{else}}
                                <img src="{{.ConfigData.AssetBaseUrl}}/assets/img/profiles/avatar-02.jpg" class="rounded-circle" alt="User">
                            {{end}}
                        </span>
                        <div class="ms-3">
                            <h3 class="mb-2">Welcome Back, {{.SessionData.UserName}}</h3>
                            <p>System Overview: <span class="text-primary fw-bold">{{.Stats.ActiveUsers}}</span> Active Users, <span class="text-primary fw-bold">{{.Stats.SuccessfulBackups}}</span> Backups, and <span class="text-primary fw-bold">{{.Stats.PendingEmails}}</span> Pending Queue Mails</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center flex-wrap mb-1">
                        <a href="#" class="btn btn-white me-2 mb-2 menu-link" data-url="{{.ConfigData.AppBaseUrl}}/settings/backup" data-title="Backup" data-parameter="" data-name="Backup" data-popup-status="0" data-popup-width="1000" data-content-div="content"><i class="ti ti-database me-1"></i>Manage Backups</a>
                        <a href="#" class="btn btn-primary mb-2 menu-link" data-url="{{.ConfigData.AppBaseUrl}}/settings/activity-logs" data-title="Activity Logs" data-parameter="" data-name="Activity Logs" data-popup-status="0" data-popup-width="1000" data-content-div="content"><i class="ti ti-activity me-1"></i>Audit Logs</a>
                    </div>
                </div>
            </div>
            <!-- /Welcome Wrap -->

            <div class="row">

                <!-- Widget Info -->
                <div class="col-xxl-8 d-flex">
                    <div class="row flex-fill">
                        <div class="col-md-3 col-sm-6 d-flex">
                            <div class="card flex-fill">
                                <div class="card-body">
                                    <span class="avatar rounded-circle bg-primary mb-2">
                                        <i class="ti ti-users fs-16"></i>
                                    </span>
                                    <h6 class="fs-13 fw-medium text-default mb-1">Active / Total Users</h6>
                                    <h3 class="mb-3">{{.Stats.ActiveUsers}} / {{.Stats.TotalUsers}}</h3>
                                    <span class="text-success fs-12 fw-medium"><i class="ti ti-circle-filled fs-8"></i> Live Accounts</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6 d-flex">
                            <div class="card flex-fill">
                                <div class="card-body">
                                    <span class="avatar rounded-circle bg-success mb-2">
                                        <i class="ti ti-user-check fs-16"></i>
                                    </span>
                                    <h6 class="fs-13 fw-medium text-default mb-1">Verified Users</h6>
                                    <h3 class="mb-3">{{.Stats.VerifiedUsers}}</h3>
                                    <span class="text-muted fs-12">Confirmed Email</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6 d-flex">
                            <div class="card flex-fill">
                                <div class="card-body">
                                    <span class="avatar rounded-circle bg-info mb-2">
                                        <i class="ti ti-user-plus fs-16"></i>
                                    </span>
                                    <h6 class="fs-13 fw-medium text-default mb-1">New Users (Month)</h6>
                                    <h3 class="mb-3">{{.Stats.NewUsersThisMonth}}</h3>
                                    <span class="text-muted fs-12">{{.Stats.NewUsersThisWeek}} this week</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6 d-flex">
                            <div class="card flex-fill">
                                <div class="card-body">
                                    <span class="avatar rounded-circle bg-purple mb-2">
                                        <i class="ti ti-database fs-16"></i>
                                    </span>
                                    <h6 class="fs-13 fw-medium text-default mb-1">System Backups</h6>
                                    <h3 class="mb-3">{{.Stats.SuccessfulBackups}} / {{.Stats.TotalBackups}}</h3>
                                    <a href="#" class="link-default menu-link" data-url="{{.ConfigData.AppBaseUrl}}/settings/backup" data-title="Backup" data-parameter="" data-name="Backup" data-popup-status="0" data-popup-width="1000" data-content-div="content">Manage Backups</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6 d-flex">
                            <div class="card flex-fill">
                                <div class="card-body">
                                    <span class="avatar rounded-circle bg-secondary mb-2">
                                        <i class="ti ti-mail-check fs-16"></i>
                                    </span>
                                    <h6 class="fs-13 fw-medium text-default mb-1">Sent Emails</h6>
                                    <h3 class="mb-3">{{.Stats.TotalEmailsSent}}</h3>
                                    <span class="text-success fs-12">Dispatched</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6 d-flex">
                            <div class="card flex-fill">
                                <div class="card-body">
                                    <span class="avatar rounded-circle bg-warning mb-2">
                                        <i class="ti ti-mail-forward fs-16"></i>
                                    </span>
                                    <h6 class="fs-13 fw-medium text-default mb-1">Pending Emails</h6>
                                    <h3 class="mb-3">{{.Stats.PendingEmails}}</h3>
                                    <span class="text-warning fs-12">In Queue</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6 d-flex">
                            <div class="card flex-fill">
                                <div class="card-body">
                                    <span class="avatar rounded-circle bg-pink mb-2">
                                        <i class="ti ti-message-check fs-16"></i>
                                    </span>
                                    <h6 class="fs-13 fw-medium text-default mb-1">Sent SMS</h6>
                                    <h3 class="mb-3">{{.Stats.TotalSmsSent}}</h3>
                                    <span class="text-success fs-12">Dispatched</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6 d-flex">
                            <div class="card flex-fill">
                                <div class="card-body">
                                    <span class="avatar rounded-circle bg-dark mb-2">
                                        <i class="ti ti-message-dots fs-16"></i>
                                    </span>
                                    <h6 class="fs-13 fw-medium text-default mb-1">Pending SMS</h6>
                                    <h3 class="mb-3">{{.Stats.PendingSms}}</h3>
                                    <span class="text-warning fs-12">In Queue</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /Widget Info -->

                <!-- Employees By Department -->
                <div class="col-xxl-4 d-flex">
                    <div class="card flex-fill">
                        <div class="card-header pb-2 d-flex align-items-center justify-content-between flex-wrap">
                            <h5 class="mb-2">Employees By Department</h5>
                            <div class="dropdown mb-2">
                                <a href="#"
                                   class="btn btn-white border btn-md d-inline-flex align-items-center"
                                   data-bs-toggle="dropdown">
                                    <i class="ti ti-calendar me-1"></i>This Week
                                </a>
                                <ul class="dropdown-menu  dropdown-menu-end p-3">
                                    <li>
                                        <a href="#" class="dropdown-item rounded-1">This Month</a>
                                    </li>
                                    <li>
                                        <a href="#" class="dropdown-item rounded-1">This Week</a>
                                    </li>
                                    <li>
                                        <a href="#" class="dropdown-item rounded-1">Last Week</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-body">
                            <div id="emp-department"></div>
                            <p class="fs-13"><i class="ti ti-circle-filled me-2 fs-8 text-primary"></i>No of
                                Employees increased by <span class="text-success fw-bold">+20%</span> from last Week
                            </p>
                        </div>
                    </div>
                </div>
                <!-- /Employees By Department -->

            </div>

            <div class="row">

                <!-- Total Employee -->
                <div class="col-xxl-4 d-flex">
                    <div class="card flex-fill">
                        <div class="card-header pb-2 d-flex align-items-center justify-content-between flex-wrap">
                            <h5 class="mb-2">Employee Status</h5>
                            <div class="dropdown mb-2">
                                <a href="#"
                                   class="btn btn-white border btn-md d-inline-flex align-items-center"
                                   data-bs-toggle="dropdown">
                                    <i class="ti ti-calendar me-1 fs-14"></i>This Week
                                </a>
                                <ul class="dropdown-menu  dropdown-menu-end p-3">
                                    <li>
                                        <a href="#" class="dropdown-item rounded-1">This Month</a>
                                    </li>
                                    <li>
                                        <a href="#" class="dropdown-item rounded-1">This Week</a>
                                    </li>
                                    <li>
                                        <a href="#" class="dropdown-item rounded-1">Today</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <p class="fs-13 mb-3">Total Employee</p>
                                <h3 class="mb-3">154</h3>
                            </div>
                            <div class="progress-stacked emp-stack mb-3">
                                <div class="progress w-40p" role="progressbar" aria-label="Segment one" aria-valuenow="15"
                                     aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar bg-warning"></div>
                                </div>
                                <div class="progress w-20p" role="progressbar" aria-label="Segment two" aria-valuenow="30"
                                     aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar bg-secondary"></div>
                                </div>
                                <div class="progress w-10p" role="progressbar" aria-label="Segment three"
                                     aria-valuenow="20" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar bg-danger"></div>
                                </div>
                                <div class="progress w-30p" role="progressbar" aria-label="Segment four"
                                     aria-valuenow="20" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar bg-pink"></div>
                                </div>
                            </div>
                            <div class="border mb-3">
                                <div class="row gx-0">
                                    <div class="col-6">
                                        <div class="p-2 flex-fill border-end border-bottom">
                                            <p class="fs-13 mb-2"><i
                                                        class="ti ti-square-rounded-filled text-primary fs-12 me-2"></i>Fulltime
                                                <span class="text-gray-9">(48%)</span>
                                            </p>
                                            <h2 class="fs-40 fw-bold">112</h2>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 flex-fill border-bottom text-end">
                                            <p class="fs-13 mb-2"><i
                                                        class="ti ti-square-rounded0filled me-2 text-secondary fs-12"></i>Contract
                                                <span class="text-gray-9">(20%)</span>
                                            </p>
                                            <h2 class="fs-40 fw-bold">112</h2>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 flex-fill border-end">
                                            <p class="fs-13 mb-2"><i
                                                        class="ti ti-square-rounded-filled me-2 text-danger fs-12"></i>Probation
                                                <span class="text-gray-9">(22%)</span>
                                            </p>
                                            <h2 class="fs-40 fw-bold">12</h2>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 flex-fill text-end">
                                            <p class="fs-13 mb-2"><i
                                                        class="ti ti-square-rounded-filled text-pink me-2 fs-12"></i>WFH
                                                <span class="text-gray-9">(20%)</span>
                                            </p>
                                            <h2 class="fs-40 fw-bold">04</h2>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <h6 class="mb-2">Top Performer</h6>
                            <div
                                    class="p-2 d-flex align-items-center justify-content-between border border-primary bg-primary-100 br-5 mb-4 perfomer-card">
                                <div class="d-flex align-items-center overflow-hidden">
                                                <span class="me-2">
                                                    <i class="ti ti-award-filled text-primary fs-24"></i>
                                                </span>
                                    <a href="employee-details.html" class="avatar avatar-md me-2">
                                        <img src="assets/img/profiles/avatar-24.jpg"
                                             class="rounded-circle border border-white" alt="img">
                                    </a>
                                    <div>
                                        <h6 class="text-truncate mb-1 fs-14 fw-medium"><a
                                                    href="employee-details.html">Daniel Esbella</a></h6>
                                        <p class="fs-13">IOS Developer</p>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <p class="fs-13 mb-1">Performance</p>
                                    <h5 class="text-primary">99%</h5>
                                </div>
                            </div>
                            <a href="employees.html" class="btn btn-light btn-md w-100">View All Employees</a>
                        </div>
                    </div>
                </div>
                <!-- /Total Employee -->

                <!-- Attendance Overview -->
                <div class="col-xxl-4 col-xl-6 d-flex">
                    <div class="card flex-fill">
                        <div class="card-header pb-2 d-flex align-items-center justify-content-between flex-wrap">
                            <h5 class="mb-2">Attendance Overview</h5>
                            <div class="dropdown mb-2">
                                <a href="#"
                                   class="border btn btn-white btn-md d-inline-flex align-items-center"
                                   data-bs-toggle="dropdown">
                                    <i class="ti ti-calendar me-1 fs-14"></i>Today
                                </a>
                                <ul class="dropdown-menu  dropdown-menu-end p-3">
                                    <li>
                                        <a href="#" class="dropdown-item rounded-1">This Month</a>
                                    </li>
                                    <li>
                                        <a href="#" class="dropdown-item rounded-1">This Week</a>
                                    </li>
                                    <li>
                                        <a href="#" class="dropdown-item rounded-1">Today</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="chartjs-wrapper-demo position-relative mb-4">
                                <canvas id="attendance" height="200"></canvas>
                                <div class="position-absolute text-center attendance-canvas">
                                    <p class="fs-13 mb-1">Total Attendance</p>
                                    <h3>120</h3>
                                </div>
                            </div>
                            <h6 class="mb-3">Status</h6>
                            <div class="d-flex align-items-center justify-content-between">
                                <p class="f-13 mb-2"><i class="ti ti-circle-filled text-success me-1"></i>Present
                                </p>
                                <p class="f-13 fw-medium text-gray-9 mb-2">59%</p>
                            </div>
                            <div class="d-flex align-items-center justify-content-between">
                                <p class="f-13 mb-2"><i class="ti ti-circle-filled text-secondary me-1"></i>Late</p>
                                <p class="f-13 fw-medium text-gray-9 mb-2">21%</p>
                            </div>
                            <div class="d-flex align-items-center justify-content-between">
                                <p class="f-13 mb-2"><i class="ti ti-circle-filled text-warning me-1"></i>Permission
                                </p>
                                <p class="f-13 fw-medium text-gray-9 mb-2">2%</p>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <p class="f-13 mb-2"><i class="ti ti-circle-filled text-danger me-1"></i>Absent</p>
                                <p class="f-13 fw-medium text-gray-9 mb-2">15%</p>
                            </div>
                            <div
                                    class="bg-light br-5 box-shadow-xs p-2 pb-0 d-flex align-items-center justify-content-between flex-wrap">
                                <div class="d-flex align-items-center">
                                    <p class="mb-2 me-2">Total Absenties</p>
                                    <div class="avatar-list-stacked avatar-group-sm mb-2">
                                                    <span class="avatar avatar-rounded">
                                                        <img class="border border-white" src="assets/img/profiles/avatar-27.jpg"
                                                             alt="img">
                                                    </span>
                                        <span class="avatar avatar-rounded">
                                                        <img class="border border-white" src="assets/img/profiles/avatar-30.jpg"
                                                             alt="img">
                                                    </span>
                                        <span class="avatar avatar-rounded">
                                                        <img src="assets/img/profiles/avatar-14.jpg" alt="img">
                                                    </span>
                                        <span class="avatar avatar-rounded">
                                                        <img src="assets/img/profiles/avatar-29.jpg" alt="img">
                                                    </span>
                                        <a class="avatar bg-primary avatar-rounded text-fixed-white fs-10"
                                           href="#">
                                            +1
                                        </a>
                                    </div>
                                </div>
                                <a href="leaves.html" class="fs-13 link-primary text-decoration-underline mb-2">View
                                    Details</a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /Attendance Overview -->

                <!-- Clock-In/Out -->
                <div class="col-xxl-4 col-xl-6 d-flex">
                    <div class="card flex-fill">
                        <div
                                class="card-header pb-2 d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <h5 class="mb-0">Clock-In/Out</h5>
                            <div class="d-flex align-items-center">
                                <div class="dropdown">
                                    <a href="#"
                                       class="dropdown-toggle btn btn-white btn-md d-inline-flex align-items-center border-0 fs-13 me-2"
                                       data-bs-toggle="dropdown">
                                        All Departments
                                    </a>
                                    <ul class="dropdown-menu  dropdown-menu-end p-3">
                                        <li>
                                            <a href="#"
                                               class="dropdown-item rounded-1">Finance</a>
                                        </li>
                                        <li>
                                            <a href="#"
                                               class="dropdown-item rounded-1">Development</a>
                                        </li>
                                        <li>
                                            <a href="#"
                                               class="dropdown-item rounded-1">Marketing</a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="dropdown">
                                    <a href="#"
                                       class="border btn btn-white btn-md d-inline-flex align-items-center"
                                       data-bs-toggle="dropdown">
                                        <i class="ti ti-calendar me-1 fs-14"></i>Today
                                    </a>
                                    <ul class="dropdown-menu  dropdown-menu-end p-3">
                                        <li>
                                            <a href="#" class="dropdown-item rounded-1">This
                                                Month</a>
                                        </li>
                                        <li>
                                            <a href="#" class="dropdown-item rounded-1">This
                                                Week</a>
                                        </li>
                                        <li>
                                            <a href="#" class="dropdown-item rounded-1">Today</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
