            <div class="row">

                <!-- System Activity Audit Trail -->
                <div class="col-xxl-4 d-flex">
                    <div class="card flex-fill">
                        <div class="card-header pb-2 d-flex align-items-center justify-content-between flex-wrap">
                            <h5 class="mb-2">Recent System Activities</h5>
                            <a href="#" class="btn btn-light btn-md mb-2 menu-link" data-url="{{.ConfigData.AppBaseUrl}}/settings/activity-logs" data-title="Activity Logs" data-parameter="" data-name="Activity Logs" data-popup-status="0" data-popup-width="1000" data-content-div="content">View All</a>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-nowrap mb-0">
                                    <tbody>
                                        {{range .RecentActivities}}
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <span class="avatar avatar-sm rounded-circle bg-primary-transparent text-primary me-2 d-flex align-items-center justify-content-center">
                                                        <i class="ti ti-activity fs-14"></i>
                                                    </span>
                                                    <div>
                                                        <h6 class="fw-medium mb-0 fs-13">{{.Activity}}</h6>
                                                        <span class="fs-11 text-muted">{{if .TableName}}Table: {{.TableName}}{{end}} {{if .IPAddress}}&bull; {{.IPAddress}}{{end}}</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-end">
                                                <div class="fs-11 text-muted">{{.CreatedAt.Format "02 Jan 15:04"}}</div>
                                            </td>
                                        </tr>
                                        {{else}}
                                        <tr>
                                            <td colspan="2" class="text-center text-muted py-4">No recent activity records</td>
                                        </tr>
                                        {{end}}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /System Activity Audit Trail -->

                <!-- Recent User Logins -->
                <div class="col-xxl-4 col-xl-6 d-flex">
                    <div class="card flex-fill">
                        <div class="card-header pb-2 d-flex align-items-center justify-content-between flex-wrap">
                            <h5 class="mb-2">Recent User Logins</h5>
                            <a href="#" class="btn btn-light btn-md mb-2 menu-link" data-url="{{.ConfigData.AppBaseUrl}}/settings/login-history" data-title="Login History" data-parameter="" data-name="Login History" data-popup-status="0" data-popup-width="1000" data-content-div="content">View All</a>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-nowrap mb-0">
                                    <tbody>
                                        {{range .RecentLogins}}
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <span class="avatar avatar-sm rounded-circle bg-info-transparent text-info me-2 d-flex align-items-center justify-content-center">
                                                        <i class="ti ti-user fs-14"></i>
                                                    </span>
                                                    <div>
                                                        <h6 class="fw-medium mb-0 fs-13">{{if .UserName}}{{.UserName}}{{else}}User #{{.UserId}}{{end}}</h6>
                                                        <span class="fs-11 text-muted">{{.IpAddress}}</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-end">
                                                <span class="badge {{if eq .LogOutStatus 0}}badge-success-transparent{{else}}badge-secondary-transparent{{end}} badge-xs">
                                                    {{if eq .LogOutStatus 0}}Active{{else}}Ended{{end}}
                                                </span>
                                                <div class="fs-11 text-muted mt-1">{{.CreatedAt.Format "02 Jan 15:04"}}</div>
                                            </td>
                                        </tr>
                                        {{else}}
                                        <tr>
                                            <td colspan="2" class="text-center text-muted py-4">No login sessions recorded yet</td>
                                        </tr>
                                        {{end}}
                                    </tbody>
                                </table>
                            </div>
