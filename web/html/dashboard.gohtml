            "DbDateFormat": "{{.DateTimeConstants.DbDateFormat}}",
            "DbDateTimeFormat": "{{.DateTimeConstants.DbDateTimeFormat}}",
            "InputDateFormat": "{{.DateTimeConstants.InputDateFormat}}",
            "InputDateTimeFormat": "{{.DateTimeConstants.InputDateTimeFormat}}",
            "JsInputDateFormat": "{{.DateTimeConstants.JsInputDateFormat}}",
            "JsInputDateTimeFormat": "{{.DateTimeConstants.JsInputDateTimeFormat}}",
            "JsViewDateFormat": "{{.DateTimeConstants.JsViewDateFormat}}",
            "JsViewDateTimeFormat": "{{.DateTimeConstants.JsViewDateTimeFormat}}"
        }{{else}}{
            "ViewDateFormat": "02 Jan 2006",
            "ViewDateTimeFormat": "02 Jan 2006 03:04 PM",
            "DbDateFormat": "2006-01-02",
            "DbDateTimeFormat": "2006-01-02 15:04:05",
            "InputDateFormat": "02/01/2006",
            "InputDateTimeFormat": "02/01/2006 15:04",
            "JsInputDateFormat": "DD/MM/YYYY",
            "JsInputDateTimeFormat": "DD/MM/YYYY HH:mm",
            "JsViewDateFormat": "DD MMM YYYY",
            "JsViewDateTimeFormat": "DD MMM YYYY hh:mm A"
        }{{end}}
        </script>
