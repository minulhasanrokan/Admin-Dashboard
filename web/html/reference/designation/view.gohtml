{{ template "include/breadcrumb" . }}
<div class="row" id="designation-view">
    <div class="col-12">
        <div class="card card-default">
            {{ template "include/grid-menu" . }}
            <div>
                <div class="border shadow-xs">
                    <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between flex-wrap gap-3 py-3 px-4">
                        <div class="d-flex align-items-center gap-2">
                            <div class="avatar avatar-sm bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center w-34 h-34">
                                <i class="ti ti-briefcase fs-16"></i>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <h6 class="mb-0 fw-bold text-dark fs-14">Designations List</h6>
                                    <span class="badge bg-primary-transparent text-primary rounded-pill fs-11 fw-semibold px-2 py-1" id="designation_total_badge">0 Records</span>
                                </div>
                                <span class="text-muted fs-12">Manage designations, operational status, approval and lifecycle</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <div class="input-group input-group-sm rounded-2 w-220 h-30">
                                <span class="input-group-text bg-light border-end-0 text-muted ps-2 pe-1 d-flex align-items-center h-30"><i class="ti ti-search fs-13"></i></span>
                                <input type="text" id="ag_quick_filter" class="form-control border-start-0 bg-light fs-12 h-30" placeholder="Search designations...">
                                <button type="button" class="btn btn-light border border-start-0 text-muted d-none align-items-center justify-content-center h-30" id="btn_ag_search_clear" title="Clear">
                                    <i class="ti ti-x fs-11"></i>
                                </button>
                            </div>
                            <button type="button" class="btn btn-sm btn-white border rounded-2 text-dark d-inline-flex align-items-center justify-content-center px-3 h-30" id="btn_refresh_ag_grid" title="Reset all filters and reload">
                                <i class="ti ti-rotate-clockwise fs-13 me-1 text-muted"></i><span class="fs-12 fw-medium">Reset</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-white border rounded-2 fs-12 fw-medium text-dark d-inline-flex align-items-center justify-content-center px-3 h-30" id="btn_ag_export_csv" title="Export to CSV">
                                <i class="ti ti-file-spreadsheet me-1 text-success fs-14"></i>Export
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <input type="hidden" id="grid_rights_json" value="{{.GridRightJSON}}">
                        <div id="designation_ag_grid" class="ag-theme-quartz custom-ag-grid ag-grid-height-450"></div>
                    </div>
                    {{ template "include/grid-footer" . }}
                </div>
            </div>
        </div>
    </div>
</div>

<script src="{{.ConfigData.AppBaseUrl}}/assets/js/reference/designation.js"></script>
