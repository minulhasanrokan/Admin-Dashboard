<!-- Single View Designation Modal -->
<div class="modal fade" id="modal_designation_single_view" tabindex="-1" aria-labelledby="modal_single_view_title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-3 border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="avatar avatar-sm bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center w-36 h-36 flex-shrink-0">
                        <i class="ti ti-eye fs-16"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark fs-15 mb-0" id="modal_single_view_title">Designation Details</h5>
                        <span class="text-muted fs-11">Complete record information, lifecycle state, and audit meta</span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-light border rounded-circle w-30 h-30 p-0 d-inline-flex align-items-center justify-content-center btn-open-activity" title="Activity Logs">
                        <i class="ti ti-activity fs-14 text-muted"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-light border rounded-circle w-30 h-30 p-0 d-inline-flex align-items-center justify-content-center btn-open-history" title="Audit History">
                        <i class="ti ti-history fs-14 text-muted"></i>
                    </button>
                    <button type="button" class="btn-close custom-btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"><i class="ti ti-x"></i></button>
                </div>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0 align-middle">
                        <tbody>
                            <tr>
                                <th class="w-30 bg-light-subtle ps-4 text-muted fs-12 fw-semibold">Designation Name</th>
                                <td id="view_name" class="ps-4 fw-bold text-dark fs-13">{{if .SingleData}}{{if .SingleData.Name}}{{.SingleData.Name}}{{end}}{{else if .name}}{{.name}}{{else}}-{{end}}</td>
                            </tr>
                            <tr>
                                <th class="bg-light-subtle ps-4 text-muted fs-12 fw-semibold">Code</th>
                                <td class="ps-4"><span class="badge bg-light text-dark border font-monospace fs-12 px-2 py-1" id="view_code">{{if .SingleData}}{{if .SingleData.Code}}{{.SingleData.Code}}{{end}}{{else if .code}}{{.code}}{{else}}-{{end}}</span></td>
                            </tr>
                            <tr>
                                <th class="bg-light-subtle ps-4 text-muted fs-12 fw-semibold">Title</th>
                                <td id="view_title" class="ps-4 text-dark fs-13">{{if .SingleData}}{{if .SingleData.Title}}{{.SingleData.Title}}{{end}}{{else if .title}}{{.title}}{{else}}-{{end}}</td>
                            </tr>
                            <tr>
                                <th class="bg-light-subtle ps-4 text-muted fs-12 fw-semibold">Details</th>
                                <td id="view_details" class="ps-4 text-muted fs-13">{{if .SingleData}}{{if .SingleData.Details}}{{.SingleData.Details}}{{end}}{{else if .details}}{{.details}}{{else}}-{{end}}</td>
                            </tr>
                            <tr>
                                <th class="bg-light-subtle ps-4 text-muted fs-12 fw-semibold">Operational Status</th>
                                <td class="ps-4"><span class="badge bg-primary-transparent text-primary fw-semibold fs-12 px-2 py-1" id="view_op_status">{{if .op_status_text}}{{.op_status_text}}{{else if .SingleData}}{{.SingleData.ActualStatus}}{{else if .actual_status}}{{.actual_status}}{{else}}-{{end}}</span></td>
                            </tr>
                            <tr>
                                <th class="bg-light-subtle ps-4 text-muted fs-12 fw-semibold">Status</th>
                                <td class="ps-4"><span class="badge bg-success-transparent text-success fw-semibold fs-12 px-2 py-1" id="view_status">{{if .SingleData}}{{if eq .SingleData.Status 1}}Active{{else}}Deactivate{{end}}{{else if .status}}{{if eq .status 1}}Active{{else}}Deactivate{{end}}{{else}}-{{end}}</span></td>
                            </tr>
                            <tr>
                                <th class="bg-light-subtle ps-4 text-muted fs-12 fw-semibold">Process Status</th>
                                <td id="view_process_status" class="ps-4 text-dark fs-13">{{if .process_status_text}}{{.process_status_text}}{{else if .SingleData}}{{.SingleData.ProcessStatus}}{{else if .process_status}}{{.process_status}}{{else}}-{{end}}</td>
                            </tr>
                            <tr>
                                <th class="bg-light-subtle ps-4 text-muted fs-12 fw-semibold">Checker</th>
                                <td id="view_checker" class="ps-4 text-dark fs-13">{{if .checker_name}}{{.checker_name}}{{else if .SingleData}}{{if .SingleData.Checker}}{{.SingleData.Checker}}{{else}}None{{end}}{{else}}None{{end}}</td>
                            </tr>
                            <tr>
                                <th class="bg-light-subtle ps-4 text-muted fs-12 fw-semibold">Message / Reason</th>
                                <td id="view_message" class="ps-4 text-dark fs-13">{{if .SingleData}}{{.SingleData.Message}}{{else if .message}}{{.message}}{{else}}-{{end}}</td>
                            </tr>
                            <tr>
                                <th class="bg-light-subtle ps-4 text-muted fs-12 fw-semibold">Remarks</th>
                                <td id="view_remarks" class="ps-4 text-dark fs-13">{{if .SingleData}}{{.SingleData.Remarks}}{{else if .remarks}}{{.remarks}}{{else}}-{{end}}</td>
                            </tr>
                            <tr>
                                <th class="bg-light-subtle ps-4 text-muted fs-12 fw-semibold">Created At</th>
                                <td class="ps-4 text-muted fs-12" id="view_created_at">{{if .created_at}}{{.created_at}}{{else if .SingleData}}{{.SingleData.CreatedAt}}{{else}}-{{end}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light border-top py-2 px-4 d-flex align-items-center justify-content-between">
                <button type="button" class="btn btn-sm btn-outline-info rounded-2 d-inline-flex align-items-center" id="btn_open_history_from_view" data-uuid="{{if .SingleData}}{{.SingleData.UUID}}{{else if .uuid}}{{.uuid}}{{end}}">
                    <i class="ti ti-history me-1 fs-14"></i>Audit History
                </button>
                <button type="button" class="btn btn-sm btn-secondary rounded-2 px-3" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
