<!-- Add Designation Modal -->
<div class="modal fade" id="modal_designation_add" tabindex="-1" aria-labelledby="modal_add_title" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-3 border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="avatar avatar-sm bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center w-36 h-36 flex-shrink-0">
                        <i class="ti ti-plus fs-16"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark fs-15 mb-0" id="modal_add_title">Add Designation</h5>
                        <span class="text-muted fs-11">Specify designation name, code, title, and descriptive details</span>
                    </div>
                </div>
                <button type="button" class="btn-close custom-btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"><i class="ti ti-x"></i></button>
            </div>
            <form id="form_designation_add">
                <input type="hidden" name="_csrf" value="{{._csrf}}">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="name" class="form-label fs-12 fw-semibold text-dark mb-1">Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control fs-13 h-30" id="name" name="name" minlength="2" maxlength="150" placeholder="e.g. Senior Software Engineer" autofocus tabindex="1">
                            <div class="invalid-feedback" id="error_msg_name"></div>
                        </div>
                        <div class="col-md-3">
                            <label for="code" class="form-label fs-12 fw-semibold text-dark mb-1">Code <span class="text-danger">*</span></label>
                            <input type="text" class="form-control fs-13 font-monospace h-30" id="code" name="code" minlength="2" maxlength="50" placeholder="e.g. SSE" tabindex="2">
                            <div class="invalid-feedback" id="error_msg_code"></div>
                        </div>
                        <div class="col-md-3">
                            <label for="title" class="form-label fs-12 fw-semibold text-dark mb-1">Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control fs-13 h-30" id="title" name="title" minlength="2" maxlength="150" placeholder="Official Title" tabindex="3">
                            <div class="invalid-feedback" id="error_msg_title"></div>
                        </div>
                        <div class="col-md-12">
                            <label for="details" class="form-label fs-12 fw-semibold text-dark mb-1">Details</label>
                            <textarea class="form-control fs-13" id="details" name="details" rows="4" maxlength="250" placeholder="Enter role responsibilities and details..." tabindex="4"></textarea>
                            <div class="invalid-feedback" id="error_msg_details"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2 px-4 d-flex align-items-center justify-content-end">
                    <button type="button" class="btn btn-sm btn-primary rounded-2 px-3 shadow-xs d-inline-flex align-items-center h-30" id="btn_save_designation_add" tabindex="5">
                        <i class="ti ti-device-floppy me-1 fs-14"></i>Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
