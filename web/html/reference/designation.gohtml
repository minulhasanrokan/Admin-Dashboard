{{ template "include/breadcrumb" . }}
<div class="row" id="designation-view">
    <div class="col-12">
        <div class="card card-default">
            {{ template "include/grid-menu" . }}
            <div>
                <div class="border shadow-xs">
                    <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between flex-wrap gap-3 py-3 px-4">
                        <div class="d-flex align-items-center gap-2">
                            <div class="avatar avatar-sm bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center w-34 h-34">
                                <i class="ti ti-briefcase fs-16"></i>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <h6 class="mb-0 fw-bold text-dark fs-14">Designations List</h6>
                                    <span class="badge bg-primary-transparent text-primary rounded-pill fs-11 fw-semibold px-2 py-1" id="designation_total_badge">0 Records</span>
                                </div>
                                <span class="text-muted fs-12">Manage designations, operational status, approval and lifecycle</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <div class="input-group input-group-sm rounded-2 w-220 h-34">
                                <span class="input-group-text bg-light border-end-0 text-muted ps-2 pe-1 d-flex align-items-center h-34"><i class="ti ti-search fs-13"></i></span>
                                <input type="text" id="ag_quick_filter" class="form-control border-start-0 bg-light fs-12 h-34" placeholder="Search designations...">
                                <button type="button" class="btn btn-light border border-start-0 text-muted d-none align-items-center justify-content-center h-34" id="btn_ag_search_clear" title="Clear">
                                    <i class="ti ti-x fs-11"></i>
                                </button>
                            </div>
                            <button type="button" class="btn btn-sm btn-white border rounded-2 text-dark d-inline-flex align-items-center justify-content-center px-3 h-34" id="btn_refresh_ag_grid" title="Reset all filters and reload">
                                <i class="ti ti-rotate-clockwise fs-13 me-1 text-muted"></i><span class="fs-12 fw-medium">Reset</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-white border rounded-2 fs-12 fw-medium text-dark d-inline-flex align-items-center justify-content-center px-3 h-34" id="btn_ag_export_csv" title="Export to CSV">
                                <i class="ti ti-file-spreadsheet me-1 text-success fs-14"></i>Export
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div id="designation_ag_grid" class="ag-theme-quartz custom-ag-grid ag-grid-height-450"></div>
                    </div>
                    {{ template "include/grid-footer" . }}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add / Edit Designation Modal -->
<div class="modal fade" id="modal_designation_form" tabindex="-1" aria-labelledby="modal_designation_title" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal_designation_title">Add Designation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="form_designation">
                <input type="hidden" id="designation_uuid" name="uuid" value="">
                <input type="hidden" id="designation_id" name="id" value="">
                <input type="hidden" name="_csrf" value="{{._csrf}}">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="designation_name" class="form-label">Designation Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="designation_name" name="name" maxlength="150" required placeholder="e.g. Senior Software Engineer">
                    </div>
                    <div class="mb-3">
                        <label for="designation_code" class="form-label">Designation Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="designation_code" name="code" maxlength="50" required placeholder="e.g. SSE-01">
                    </div>
                    <div class="mb-3">
                        <label for="designation_title" class="form-label">Display Title <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="designation_title" name="title" maxlength="150" required placeholder="e.g. Lead Developer">
                    </div>
                    <div class="mb-3">
                        <label for="designation_details" class="form-label">Details / Description</label>
                        <textarea class="form-control" id="designation_details" name="details" rows="3" placeholder="Enter optional details..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btn_save_designation">Save Designation</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Details View Modal -->
<div class="modal fade" id="modal_designation_view" tabindex="-1" aria-labelledby="modal_view_title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal_view_title">Designation Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0">
                        <tbody>
                            <tr>
                                <th class="w-30 bg-light">Designation Name</th>
                                <td id="view_name" class="fw-semibold text-dark">-</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Code</th>
                                <td id="view_code">-</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Title</th>
                                <td id="view_title">-</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Details</th>
                                <td id="view_details">-</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Operational Status (OP-Status)</th>
                                <td id="view_op_status">-</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Status</th>
                                <td id="view_status">-</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Process Status</th>
                                <td id="view_process_status">-</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Checker</th>
                                <td id="view_checker">-</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Message / Reason</th>
                                <td id="view_message">-</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Remarks</th>
                                <td id="view_remarks">-</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Created At</th>
                                <td id="view_created_at">-</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-info" id="btn_open_history_from_view"><i class="ti ti-history me-1"></i>Audit History</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Reason Modal -->
<div class="modal fade" id="modal_designation_delete" tabindex="-1" aria-labelledby="modal_delete_title" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger-subtle text-danger">
                <h5 class="modal-title" id="modal_delete_title"><i class="ti ti-alert-triangle me-1"></i>Delete Designation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="form_designation_delete">
                <input type="hidden" id="delete_target_id" name="target_id" value="">
                <input type="hidden" name="_csrf" value="{{._csrf}}">
                <div class="modal-body">
                    <p class="mb-2">Are you sure you want to delete designation: <strong id="delete_designation_name">-</strong>?</p>
                    <div class="mb-3">
                        <label for="delete_reason" class="form-label">Delete Reason <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="delete_reason" name="delete_reason" rows="3" maxlength="250" required placeholder="State reason for deleting this designation..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger" id="btn_confirm_delete">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Sent To Checker Modal -->
<div class="modal fade" id="modal_designation_stc" tabindex="-1" aria-labelledby="modal_stc_title" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal_stc_title"><i class="ti ti-arrow-forward-up me-1 text-primary"></i>Sent To Checker</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="form_designation_stc">
                <input type="hidden" id="stc_target_id" name="target_id" value="">
                <input type="hidden" name="_csrf" value="{{._csrf}}">
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label text-muted">Designation</label>
                        <div class="fw-bold fs-14" id="stc_designation_name">-</div>
                    </div>
                    <div class="mb-3">
                        <label for="stc_checker" class="form-label">Checker User <span class="text-danger">*</span></label>
                        <select class="form-select" id="stc_checker" name="checker" required>
                            <option value="">-- Select Checker --</option>
                            {{range .CheckerUsers}}
                                <option value="{{.id}}">{{.name}}</option>
                            {{end}}
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="stc_notify_type" class="form-label">Notify Type <span class="text-danger">*</span></label>
                        <select class="form-select" id="stc_notify_type" name="notify_type" required>
                            <option value="1">Email Notification</option>
                            <option value="2">SMS Notification</option>
                            <option value="3">Both Email & SMS</option>
                            <option value="4">System Notification</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="stc_remarks" class="form-label">Remarks</label>
                        <textarea class="form-control" id="stc_remarks" name="remarks" rows="3" maxlength="250" placeholder="Optional remarks for checker..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btn_confirm_stc">Send To Checker</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Verify Modal -->
<div class="modal fade" id="modal_designation_verify" tabindex="-1" aria-labelledby="modal_verify_title" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal_verify_title"><i class="ti ti-check me-1 text-success"></i>Verify Designation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="form_designation_verify">
                <input type="hidden" id="verify_target_id" name="target_id" value="">
                <input type="hidden" name="_csrf" value="{{._csrf}}">
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label text-muted">Designation</label>
                        <div class="fw-bold fs-14" id="verify_designation_name">-</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Decision <span class="text-danger">*</span></label>
                        <div class="d-flex align-items-center gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="verify_type" id="verify_type_approve" value="1" checked>
                                <label class="form-check-label text-success fw-bold" for="verify_type_approve">
                                    <i class="ti ti-check me-1"></i>Approve
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="verify_type" id="verify_type_return" value="0">
                                <label class="form-check-label text-warning fw-bold" for="verify_type_return">
                                    <i class="ti ti-arrow-back-up me-1"></i>Return / Reject
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3 d-none" id="group_return_reason">
                        <label for="verify_return_reason" class="form-label">Return Reason <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="verify_return_reason" name="return_reason" rows="3" maxlength="250" placeholder="State reason for returning this record..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btn_confirm_verify">Submit Decision</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Active / Deactive Reason Modal -->
<div class="modal fade" id="modal_designation_status" tabindex="-1" aria-labelledby="modal_status_title" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal_status_title">Update Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="form_designation_status">
                <input type="hidden" id="status_target_id" name="target_id" value="">
                <input type="hidden" id="status_action_type" name="action_type" value="">
                <input type="hidden" name="_csrf" value="{{._csrf}}">
                <div class="modal-body">
                    <div class="mb-2">
                        <p class="mb-1" id="status_prompt_text">Please state the reason for this action:</p>
                        <div class="fw-bold fs-14" id="status_designation_name">-</div>
                    </div>
                    <div class="mb-3">
                        <label for="status_reason" class="form-label">Reason <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="status_reason" name="reason" rows="3" maxlength="250" required placeholder="Enter reason..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btn_confirm_status">Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- History Modal -->
<div class="modal fade" id="modal_designation_history" tabindex="-1" aria-labelledby="modal_history_title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal_history_title"><i class="ti ti-history me-1 text-primary"></i>Designation Audit History</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-sm table-striped table-bordered mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Code</th>
                                <th>Title</th>
                                <th>OP-Status</th>
                                <th>Process Status</th>
                                <th>Status</th>
                                <th>Message</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody id="history_table_body">
                            <tr><td colspan="9" class="text-center py-3 text-muted">No history found</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="{{.ConfigData.AppBaseUrl}}/assets/js/reference/designation.js"></script>
