{{ define "include/dashboard/stacked-sidebar" }}
    <div class="stacked-sidebar" id="stacked-sidebar">
        <div class="sidebar sidebar-stacked d-flex">
            <div class="stacked-mini">
                <a href="{{.ConfigData.AppBaseUrl}}/dashboard" class="logo-small">
                    <img src="{{.ConfigData.AppBaseUrl}}/file/system/{{.SystemSetting.LogoSmall}}" alt="{{.SystemSetting.Name}}">
                </a>
                <div class="sidebar-left slimscroll">
                    <div class="d-flex align-items-center flex-column">
                        <div class="mb-1 notification-item">
                            <a href="#" class="btn btn-menubar position-relative">
                                <i class="ti ti-bell"></i>
                                <span class="notification-status-dot"></span>
                            </a>
                        </div>
                        <div class="mb-1">
                            <a href="#" class="btn btn-menubar btnFullscreen">
                                <i class="ti ti-maximize"></i>
                            </a>
                        </div>
                        <div class="mb-1">
                            <a href="#" class="btn btn-menubar position-relative">
                                <i class="ti ti-brand-hipchat"></i>
                            </a>
                        </div>
                        <div class="mb-1">
                            <a href="#" class="btn btn-menubar">
                                <i class="ti ti-mail"></i>
                            </a>
                        </div>
                        <div class="mb-1">
                            <a href="#" class="btn btn-calender">
                                <i class="ti ti-mail"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="sidebar-right d-flex justify-content-between flex-column">
                <div class="sidebar-scroll">
                    <h6 class="mb-3">Welcome to {{.SystemSetting.Name}}</h6>
                    <a href="#" class="sidebar-profile d-block text-center rounded bg-light p-3 mb-4 text-decoration-none menu-link" data-url="{{.ConfigData.AppBaseUrl}}/profile" data-title="My Profile" data-parameter="" data-name="My Profile" data-popup-status="0" data-popup-width="1000" data-content-div="content">
                        <div class="avatar avatar-lg online mb-3">
                            <img src="{{.ConfigData.AppBaseUrl}}/file/user/{{.SessionData.Photo}}" alt="{{.SessionData.UserName}}" class="img-fluid rounded-circle">
                        </div>
                        <h6 class="fs-12 fw-normal mb-1 text-dark">{{.SessionData.UserName}}</h6>
                        <p class="fs-10 text-muted mb-0">System Admin</p>
                    </a>
                    <div class="stack-menu">
                        <div class="nav flex-column align-items-center nav-pills" role="tablist"
                             aria-orientation="vertical">
                            <div class="row g-2">
                                {{ range .MenuTree }}
                                    <div class="col-6">
                                        <a href="#menu-{{ .Key }}" role="tab" class="nav-link" title="{{ .Title }}"
                                           data-bs-toggle="tab" data-bs-target="#menu-{{ .Key }}"
                                           aria-selected="false">
                                            <span><i class="{{ .Icon }}"></i></span>
                                            <p>{{ .Title }}</p>
                                        </a>
                                    </div>
                                {{ end }}
                            </div>
                        </div>
                        <div class="tab-content">
                            {{ range .MenuTree }}
                                <div class="tab-pane fade" id="menu-{{ .Key }}">
                                    <ul class="stack-submenu">
                                        {{ range .Categories }}
                                            <li>
                                                <a href="#" class="menu-link" data-url="{{ .Url }}" data-title="{{ .Title }}" data-parameter="" data-name="{{ .Name }}" data-popup-status="0" data-popup-width="1000" data-content-div="content">{{ .Title }}</a>
                                            </li>
                                        {{ end }}
                                    </ul>
                                </div>
                            {{ end }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{{ end }}