{{ define "include/breadcrumb" }}
    <div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">
        <div class="my-auto mb-2">
            <h2 class="mb-1">{{.RouteActionDetails.GroupName}}</h2>
            <nav>
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="{{.ConfigData.AppBaseUrl}}"><i class="ti ti-smart-home"></i></a>
                    </li>
                    <li class="breadcrumb-item">{{.RouteActionDetails.CategoryName}}</li>
                    <li class="breadcrumb-item active" aria-current="page">{{.RouteActionDetails.RightName}}</li>
                </ol>
            </nav>
        </div>
        <div class="head-icons ms-2">
            <a href="#" class="" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-original-title="Collapse" id="collapse-header"><i class="ti ti-chevrons-up"></i></a>
        </div>
    </div>
{{ end }}