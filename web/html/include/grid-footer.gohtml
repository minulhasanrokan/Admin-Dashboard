{{ define "include/grid-footer" }}
    <div class="card-footer bg-white border-top d-flex align-items-center justify-content-between flex-wrap gap-3 py-3 px-4" id="ag_custom_pagination">
        <div class="d-flex align-items-center gap-1">
            <span class="text-muted fs-12" id="ag_page_info">
                Showing <b class="text-dark fw-bold" id="ag_page_start">0</b> to <b class="text-dark fw-bold" id="ag_page_end">0</b> of <b class="text-dark fw-bold" id="ag_page_total">0</b> entries
            </span>
        </div>
        <div class="d-flex align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-2">
                <label for="ag_page_size" class="fs-12 text-muted mb-0">Rows per page:</label>
                <select id="ag_page_size" class="form-select form-select-sm border rounded-2 fs-12 text-dark bg-white py-1 px-2 w-75 cursor-pointer">
                    {{ if .PaginationConstants }}
                        {{ range .PaginationConstants.PageLimits }}
                            <option value="{{.}}" {{ if eq . $.PaginationConstants.DefaultLimit }}selected{{ end }}>{{.}}</option>
                        {{ end }}
                    {{ else }}
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    {{ end }}
                </select>
            </div>
            <nav aria-label="Grid pagination">
                <ul class="pagination pagination-sm mb-0 gap-1 align-items-center" id="ag_pagination_list"></ul>
            </nav>
        </div>
    </div>
{{ end }}