<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
        <meta name="_csrf" content="{{ ._csrf }}">
        <title>Verify Account | {{.SystemSetting.Name}} - {{.SystemSetting.Title}}</title>
        <link rel="shortcut icon" type="image/x-icon" href="{{.ConfigData.AppBaseUrl}}/file/system/{{.SystemSetting.Icon}}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{.ConfigData.AppBaseUrl}}/file/system/{{.SystemSetting.AppleIcon}}">
        <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/css/bootstrap.min.css">
        <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/plugins/icons/feather/feather.css">
        <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/plugins/tabler-icons/tabler-icons.min.css">
        <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/plugins/fontawesome/css/fontawesome.min.css">
        <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/plugins/fontawesome/css/all.min.css">
        <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/css/style.css">
        <link rel="stylesheet" href="{{.ConfigData.AssetBaseUrl}}/assets/css/common.css">
    </head>
    <body class="bg-white">
        {{ template "include/loader" . }}
        <div class="main-wrapper">
            <div class="container-fluid">
                <div class="w-100 overflow-hidden position-relative flex-wrap d-block vh-100">
                    <div class="row">
                        <div class="col-lg-5">
                            <div class="d-lg-flex align-items-center justify-content-center d-none flex-wrap vh-100 bg-primary-transparent">
                                <div>
                                    <img src="{{.ConfigData.AssetBaseUrl}}/file/system/{{.SystemSetting.VerificationBg}}" alt="{{.SystemSetting.Name}}">
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-7 col-md-12 col-sm-12">
                            <div class="row justify-content-center align-items-center vh-100 overflow-auto flex-wrap ">
                                <div class="col-md-7 mx-auto p-4">
                                    <form action="#" class="digit-group">
                                        <input type="hidden" name="uuid" id="uuid" value="{{.UuId}}">
                                        <div>
                                            <div class=" mx-auto mb-5 text-center">
                                                <img src="{{.ConfigData.AssetBaseUrl}}/file/system/{{.SystemSetting.Logo}}" alt="{{.SystemSetting.Name}}">
                                            </div>
                                            <div class="">
                                                <div class="text-center mb-3">
                                                    <h2 class="mb-2">Email OTP Verification</h2>
                                                    <p class="mb-0">Please enter the OTP received to confirm your account ownership. A code has been sent to {{.Email}}</p>
                                                </div>
                                                <div class="text-center otp-input">
                                                    <div class="d-flex align-items-center mb-3">
                                                        <input type="text" class=" rounded w-100 py-sm-3 py-2 text-center fs-26 fw-bold me-3" id="digit_one" name="digit_one" data-next="digit_two" minlength="1" maxlength="1">
                                                        <input type="text" class=" rounded w-100 py-sm-3 py-2 text-center fs-26 fw-bold me-3" id="digit_two" name="digit_two" data-next="digit_three" data-previous="digit_one" minlength="1" maxlength="1">
                                                        <input type="text" class=" rounded w-100 py-sm-3 py-2 text-center fs-26 fw-bold me-3" id="digit_three" name="digit_three" data-next="digit_four" data-previous="digit_two" minlength="1" maxlength="1">
                                                        <input type="text" class=" rounded w-100 py-sm-3 py-2 text-center fs-26 fw-bold" id="digit_four" name="digit_four" data-next="digit_five" data-previous="digit_three" minlength="1" maxlength="1">
                                                    </div>
                                                    <div class="d-flex align-items-center mb-3">
                                                        <div class="invalid-feedback rounded w-100 py-sm-3 py-2 text-center fw-bold me-3" id="error_msg_digit_one"></div>
                                                        <div class="invalid-feedback rounded w-100 py-sm-3 py-2 text-center fw-bold me-3" id="error_msg_digit_two"></div>
                                                        <div class="invalid-feedback rounded w-100 py-sm-3 py-2 text-center fw-bold me-3" id="error_msg_digit_three"></div>
                                                        <div class="invalid-feedback rounded w-100 py-sm-3 py-2 text-center fw-bold me-3" id="error_msg_digit_four"></div>
                                                    </div>
                                                    <div class="badge bg-danger-transparent mb-3">
                                                        <p class="d-flex align-items-center mb-0">
                                                            <i class="ti ti-clock me-1"></i>
                                                            <span id="timer" data-minutes="{{if .AuthSetting}}{{.AuthSetting.VerificationExpired}}{{else}}{{.ConfigData.VerificationTokenMinute}}{{end}}">{{if .AuthSetting}}{{.AuthSetting.VerificationExpired}}{{else}}{{.ConfigData.VerificationTokenMinute}}{{end}}:00</span>
                                                        </p>
                                                    </div>
                                                    <div class="mb-3 d-flex justify-content-center">
                                                        <p class="text-gray-9 mb-0">Didn't get the OTP?<a href="#" id="resend_otp" class="text-primary disabled-link">Resend OTP</a>
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <button type="button" id="verify_account" class="btn btn-primary w-100">Verify & Proceed</button>
                                                </div>
                                            </div>
                                            <div class="mt-5 text-center">
                                                <p class="mb-0 text-gray-9">{{.SystemSetting.CopyRight}}</p>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/jquery-3.7.1.min.js"></script>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/axios.min.js"></script>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/bootstrap.bundle.min.js"></script>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/feather.min.js"></script>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/script.js"></script>
        <script defer src="{{.ConfigData.AssetBaseUrl}}/assets/js/beacon.min.js"></script>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/notify.js"></script>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/config.js"></script>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/common.js"></script>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/timer.js"></script>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/form_validation.js"></script>
        <script src="{{.ConfigData.AssetBaseUrl}}/assets/js/user/verification.js"></script>
    </body>
</html>