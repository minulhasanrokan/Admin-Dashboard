{{ template "include/breadcrumb" . }}
{{ template "settings/include/setting_menu" . }}
<div class="row" id="email-settings-view">
    <div class="col-xl-3 theiaStickySidebar">
        <div class="card">
            <div class="card-body">
                <div class="d-flex flex-column list-group settings-list">
                    <a href="#" class="d-inline-flex align-items-center rounded active py-2 px-3 menu-link" data-url="{{.ConfigData.AppBaseUrl}}/settings/email-settings" data-title="Email Settings" data-parameter="" data-name="Email Settings" data-popup-status="0" data-popup-width="1000" data-content-div="content"><i class="ti ti-arrow-badge-right me-2"></i>Email Settings</a>
                    <a href="#" class="d-inline-flex align-items-center rounded py-2 px-3 menu-link" data-url="{{.ConfigData.AppBaseUrl}}/settings/sms-settings" data-title="SMS Settings" data-parameter="" data-name="SMS Settings" data-popup-status="0" data-popup-width="1000" data-content-div="content">SMS Settings</a>
                    <a href="#" class="d-inline-flex align-items-center rounded py-2 px-3 menu-link" data-url="{{.ConfigData.AppBaseUrl}}/settings/user-roles-settings" data-title="User Roles" data-parameter="" data-name="User Roles" data-popup-status="0" data-popup-width="1000" data-content-div="content">User Roles</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-9" id="email-settings-edit-details">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center border-bottom mb-3 pb-3">
                    <div>
                        <h4 class="mb-1">Email Settings</h4>
                        <p class="text-muted mb-0 small">Configure your outgoing mail sender identities, mail drivers, and server credentials.</p>
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center" id="test_email_modal_button" data-bs-toggle="modal" data-bs-target="#modal_test_email">
                        <i class="ti ti-send me-1"></i> Send Test Email
                    </button>
                </div>
                <form action="#" id="email-settings-edit-form">
                    <div class="border-bottom mb-3 pb-3">
                        <div class="row">
                            <div class="col-md-12">
                                <div>
                                    <h6 class="mb-3">General Sender Information</h6>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="row align-items-center mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label mb-md-0" for="from_email">From Email <span class="color-red">*</span></label>
                                    </div>
                                    <div class="col-md-8">
                                        <input tabindex="1" value="{{.EmailSetting.GetFromEmail}}" type="email" name="from_email" id="from_email" minlength="5" maxlength="100" class="form-control" placeholder="admin@example.com">
                                        <div class="invalid-feedback" id="error_msg_from_email"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row align-items-center mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label mb-md-0" for="from_name">From Name <span class="color-red">*</span></label>
                                    </div>
                                    <div class="col-md-8">
                                        <input tabindex="2" type="text" value="{{.EmailSetting.GetFromName}}" name="from_name" id="from_name" minlength="2" maxlength="200" class="form-control" placeholder="Company or System Name">
                                        <div class="invalid-feedback" id="error_msg_from_name"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="border-bottom mb-3 pb-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0 text-dark fw-semibold"><i class="ti ti-mail-fast me-1 text-primary"></i> Mail Drivers &amp; Gateways</h6>
                            <small class="text-muted">Select the active mail driver by switching the toggle switch.</small>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4 d-flex">
                                <div class="card flex-fill border shadow-sm {{if eq .EmailSetting.MailDriver "sendgrid"}}border-primary{{end}}" id="card-sendgrid">
                                    <div class="card-body d-flex flex-column justify-content-between p-3">
                                        <div>
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div class="d-flex align-items-center">
                                                    <span class="avatar avatar-lg p-2 me-2 bg-light rounded flex-shrink-0">
                                                        <img src="{{.ConfigData.AssetBaseUrl}}/assets/images/settings/send-grid.svg" alt="Send Grid" width="28" height="28">
                                                    </span>
                                                    <h5 class="mb-0 fs-15">Send Grid</h5>
                                                </div>
                                                <div class="form-check form-switch mb-0">
                                                    <input tabindex="3" {{if eq .EmailSetting.MailDriver "sendgrid"}}checked{{end}} class="form-check-input" value="sendgrid" id="send-grid-driver" name="mail_driver" type="radio" role="switch" title="Set as Active Driver">
                                                </div>
                                            </div>
                                            <p class="text-muted small mb-3">Used to deliver transactional and marketing emails at scale via cloud APIs or SMTP relay with built-in analytics and deliverability optimization.</p>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                            {{if .EmailSetting.HasSendgrid}}
                                                <span class="badge bg-success-transparent text-success fw-semibold" id="sendgrid-status-badge">
                                                    <i class="ti ti-checks me-1"></i>Configured
                                                </span>
                                            {{else}}
                                                <span class="badge bg-light text-muted border fw-normal" id="sendgrid-status-badge">
                                                    <i class="ti ti-alert-circle me-1"></i>Not Configured
                                                </span>
                                            {{end}}
                                            <button type="button" class="btn btn-icon btn-sm btn-outline-secondary fs-18" id="email-setting-modal-sendgrid" title="Configure SendGrid Settings" data-bs-toggle="modal" data-bs-target="#modal_sendgrid">
                                                <i class="ti ti-settings"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4 d-flex">
                                <div class="card flex-fill border shadow-sm {{if eq .EmailSetting.MailDriver "smtp"}}border-primary{{end}}" id="card-smtp">
                                    <div class="card-body d-flex flex-column justify-content-between p-3">
                                        <div>
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div class="d-flex align-items-center">
                                                    <span class="avatar avatar-lg p-2 me-2 bg-light rounded flex-shrink-0">
                                                        <img src="{{.ConfigData.AssetBaseUrl}}/assets/images/settings/smtp.svg" alt="SMTP" width="28" height="28">
                                                    </span>
                                                    <h5 class="mb-0 fs-15">SMTP</h5>
                                                </div>
                                                <div class="form-check form-switch mb-0">
                                                    <input tabindex="4" {{if eq .EmailSetting.MailDriver "smtp"}}checked{{end}} class="form-check-input" value="smtp" type="radio" role="switch" id="smtp-driver" name="mail_driver" title="Set as Active Driver">
                                                </div>
                                            </div>
                                            <p class="text-muted small mb-3">Used to transmit emails directly through a standard mail server using authentication and TLS/SSL encryption from any web application.</p>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                            {{if .EmailSetting.HasSmtp}}
                                                <span class="badge bg-success-transparent text-success fw-semibold" id="smtp-status-badge">
                                                    <i class="ti ti-checks me-1"></i>Configured
                                                </span>
                                            {{else}}
                                                <span class="badge bg-light text-muted border fw-normal" id="smtp-status-badge">
                                                    <i class="ti ti-alert-circle me-1"></i>Not Configured
                                                </span>
                                            {{end}}
                                            <button type="button" class="btn btn-icon btn-sm btn-outline-secondary fs-18" id="email-setting-modal-smtp" title="Configure SMTP Settings" data-bs-toggle="modal" data-bs-target="#modal_smtp">
                                                <i class="ti ti-settings"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4 d-flex">
                                <div class="card flex-fill border shadow-sm {{if eq .EmailSetting.MailDriver "ses"}}border-primary{{end}}" id="card-ses">
                                    <div class="card-body d-flex flex-column justify-content-between p-3">
                                        <div>
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div class="d-flex align-items-center">
                                                    <span class="avatar avatar-lg p-2 me-2 bg-light rounded flex-shrink-0">
                                                        <img src="{{.ConfigData.AssetBaseUrl}}/assets/images/settings/aws.svg" alt="AWS SES" width="28" height="28">
                                                    </span>
                                                    <h5 class="mb-0 fs-15">AWS SES</h5>
                                                </div>
                                                <div class="form-check form-switch mb-0">
                                                    <input tabindex="5" {{if eq .EmailSetting.MailDriver "ses"}}checked{{end}} class="form-check-input" value="ses" type="radio" role="switch" id="aws-ses-driver" name="mail_driver" title="Set as Active Driver">
                                                </div>
                                            </div>
                                            <p class="text-muted small mb-3">Used to send high-volume transactional and marketing emails cost-effectively through AWS's cloud infrastructure using secure IAM API credentials or SMTP credentials.</p>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                            {{if .EmailSetting.HasSes}}
                                                <span class="badge bg-success-transparent text-success fw-semibold" id="ses-status-badge">
                                                    <i class="ti ti-checks me-1"></i>Configured
                                                </span>
                                            {{else}}
                                                <span class="badge bg-light text-muted border fw-normal" id="ses-status-badge">
                                                    <i class="ti ti-alert-circle me-1"></i>Not Configured
                                                </span>
                                            {{end}}
                                            <button type="button" class="btn btn-icon btn-sm btn-outline-secondary fs-18" id="email-setting-modal-ses" title="Configure AWS SES Settings" data-bs-toggle="modal" data-bs-target="#modal_ses">
                                                <i class="ti ti-settings"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="invalid-feedback" id="error_msg_mail_driver"></div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-end">
                        <button type="button" tabindex="6" id="email_setting_button" class="btn btn-primary d-inline-flex align-items-center">
                            <i class="ti ti-device-floppy me-1"></i> Save Email Settings
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal_sendgrid" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modal_sendgrid_label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-md p-2 me-2 bg-light rounded flex-shrink-0">
                        <img src="{{.ConfigData.AssetBaseUrl}}/assets/images/settings/send-grid.svg" alt="Send Grid" width="24" height="24">
                    </span>
                    <h5 class="modal-title" id="modal_sendgrid_label">SendGrid API Configuration</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info py-2 px-3 mb-3 small d-flex align-items-center">
                    <i class="ti ti-info-circle fs-18 me-2 flex-shrink-0"></i>
                    <span>Generate your API key from the <a href="https://app.sendgrid.com/settings/api_keys" target="_blank" class="alert-link text-decoration-underline">SendGrid Console</a> with <strong>Mail Send</strong> permissions.</span>
                </div>
                <form id="form_sendgrid_setting">
                    <div class="row align-items-center mb-3">
                        <div class="col-md-4">
                            <label class="form-label mb-md-0" for="sendgrid_api_key">SendGrid API Key <span class="color-red">*</span></label>
                        </div>
                        <div class="col-md-8">
                            <div class="input-group">
                                <input type="password" class="form-control" id="sendgrid_api_key" name="sendgrid_api_key" placeholder="SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" value="{{.EmailSetting.GetSendgridApiKey}}" autocomplete="off">
                                <span class="input-group-text cursor-pointer toggle-password" data-target="#sendgrid_api_key" title="Toggle Visibility">
                                    <i class="ti ti-eye"></i>
                                </span>
                            </div>
                            <div class="invalid-feedback" id="error_msg_sendgrid_api_key"></div>
                            <small class="text-muted">Stored securely with AES-GCM 256-bit encryption.</small>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary d-inline-flex align-items-center" id="save_sendgrid_btn">
                    <i class="ti ti-device-floppy me-1"></i> Save SendGrid Settings
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal_smtp" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false" tabindex="-1" aria-labelledby="modal_smtp_label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-md p-2 me-2 bg-light rounded flex-shrink-0">
                        <img src="{{.ConfigData.AssetBaseUrl}}/assets/images/settings/smtp.svg" alt="SMTP" width="24" height="24">
                    </span>
                    <h5 class="modal-title" id="modal_smtp_label">SMTP Server Configuration</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info py-2 px-3 mb-3 small d-flex align-items-center">
                    <i class="ti ti-info-circle fs-18 me-2 flex-shrink-0"></i>
                    <span>Configure your standard outgoing SMTP mail server (e.g., Mailtrap, Gmail, Postmark, Brevo, or custom server).</span>
                </div>
                <form id="form_smtp_setting">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="row align-items-center mb-3">
                                <div class="col-md-4">
                                    <label class="form-label mb-md-0" for="smtp_host">SMTP Host <span class="color-red">*</span></label>
                                </div>
                                <div class="col-md-8">
                                    <input type="text" class="form-control" id="smtp_host" name="smtp_host" placeholder="sandbox.smtp.mailtrap.io" value="{{.EmailSetting.GetSmtpHost}}">
                                    <div class="invalid-feedback" id="error_msg_smtp_host"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row align-items-center mb-3">
                                <div class="col-md-4">
                                    <label class="form-label mb-md-0" for="smtp_port">SMTP Port <span class="color-red">*</span></label>
                                </div>
                                <div class="col-md-8">
                                    <input type="text" class="form-control" id="smtp_port" name="smtp_port" placeholder="587" value="{{.EmailSetting.GetSmtpPort}}" min="1" max="65535">
                                    <div class="invalid-feedback" id="error_msg_smtp_port"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row align-items-center mb-3">
                                <div class="col-md-4">
                                    <label class="form-label mb-md-0" for="smtp_username">Username <span class="color-red">*</span></label>
                                </div>
                                <div class="col-md-8">
                                    <input type="text" class="form-control" id="smtp_username" name="smtp_username" placeholder="Username or API User" value="{{.EmailSetting.GetSmtpUsername}}" autocomplete="off">
                                    <div class="invalid-feedback" id="error_msg_smtp_username"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row align-items-center mb-3">
                                <div class="col-md-4">
                                    <label class="form-label mb-md-0" for="smtp_password">Password</label>
                                </div>
                                <div class="col-md-8">
                                    <div class="input-group">
                                        <input type="password" class="form-control" id="smtp_password" name="smtp_password" placeholder="Enter password" value="{{.EmailSetting.GetSmtpPassword}}" autocomplete="new-password">
                                        <span class="input-group-text cursor-pointer toggle-password" data-target="#smtp_password" title="Toggle Visibility">
                                            <i class="ti ti-eye"></i>
                                        </span>
                                    </div>
                                    <div class="invalid-feedback" id="error_msg_smtp_password"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row align-items-center mb-3">
                                <div class="col-md-4">
                                    <label class="form-label mb-md-0" for="smtp_encryption">Encryption <span class="color-red">*</span></label>
                                </div>
                                <div class="col-md-8">
                                    <select class="select" id="smtp_encryption" name="smtp_encryption">
                                        <option value="" {{if eq $.EmailSetting.GetSmtpEncryption ""}}selected{{end}}>Select Encryption</option>
                                        {{range .EmailSetting.GetSmtpEncryptionProtocols}}
                                        <option value="{{.Value}}" {{if eq $.EmailSetting.GetSmtpEncryption .Value}}selected{{end}}>{{.Label}}</option>
                                        {{end}}
                                    </select>
                                    <div class="invalid-feedback" id="error_msg_smtp_encryption"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary d-inline-flex align-items-center" id="save_smtp_btn">
                    <i class="ti ti-device-floppy me-1"></i> Save SMTP Settings
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal_ses" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false" tabindex="-1" aria-labelledby="modal_ses_label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-md p-2 me-2 bg-light rounded flex-shrink-0">
                        <img src="{{.ConfigData.AssetBaseUrl}}/assets/images/settings/aws.svg" alt="AWS SES" width="24" height="24">
                    </span>
                    <h5 class="modal-title" id="modal_ses_label">Amazon Simple Email Service (SES) Configuration</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info py-2 px-3 mb-3 small d-flex align-items-center">
                    <i class="ti ti-info-circle fs-18 me-2 flex-shrink-0"></i>
                    <span>Configure your AWS IAM credentials with <code>ses:SendEmail</code> or <code>ses:SendRawEmail</code> permissions.</span>
                </div>
                <form id="form_ses_setting">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="row align-items-center mb-3">
                                <div class="col-md-4">
                                    <label class="form-label mb-md-0" for="aws_access_key_id">Access Key ID <span class="color-red">*</span></label>
                                </div>
                                <div class="col-md-8">
                                    <input type="text" class="form-control" id="aws_access_key_id" name="aws_access_key_id" placeholder="AKIAXXXXXXXXXXXXXXXX" value="{{.EmailSetting.GetAwsAccessKeyId}}" autocomplete="off">
                                    <div class="invalid-feedback" id="error_msg_aws_access_key_id"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row align-items-center mb-3">
                                <div class="col-md-4">
                                    <label class="form-label mb-md-0" for="aws_secret_access_key">Secret Key</label>
                                </div>
                                <div class="col-md-8">
                                    <div class="input-group">
                                        <input type="password" class="form-control" id="aws_secret_access_key" name="aws_secret_access_key" placeholder="Enter AWS secret access key" value="{{.EmailSetting.GetAwsSecretAccessKey}}" autocomplete="new-password">
                                        <span class="input-group-text cursor-pointer toggle-password" data-target="#aws_secret_access_key" title="Toggle Visibility">
                                            <i class="ti ti-eye"></i>
                                        </span>
                                    </div>
                                    <div class="invalid-feedback" id="error_msg_aws_secret_access_key"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row align-items-center mb-3">
                                <div class="col-md-4">
                                    <label class="form-label mb-md-0" for="aws_region">AWS Region <span class="color-red">*</span></label>
                                </div>
                                <div class="col-md-8">
                                    <select class="select" id="aws_region" name="aws_region">
                                        <option value="" {{if eq $.EmailSetting.GetAwsRegion ""}}selected{{end}}>Select AWS Region</option>
                                        {{range .EmailSetting.GetAwsRegions}}
                                        <option value="{{.Value}}" {{if eq $.EmailSetting.GetAwsRegion .Value}}selected{{end}}>{{.Label}}</option>
                                        {{end}}
                                    </select>
                                    <div class="invalid-feedback" id="error_msg_aws_region"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row align-items-center mb-3">
                                <div class="col-md-4">
                                    <label class="form-label mb-md-0" for="aws_config_set">Config Set</label>
                                </div>
                                <div class="col-md-8">
                                    <input type="text" class="form-control" id="aws_config_set" name="aws_config_set" placeholder="Optional SES Configuration Set" value="{{.EmailSetting.GetAwsConfigSet}}">
                                    <div class="invalid-feedback" id="error_msg_aws_config_set"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary d-inline-flex align-items-center" id="save_ses_btn">
                    <i class="ti ti-device-floppy me-1"></i> Save AWS SES Settings
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal_test_email" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modal_test_email_label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal_test_email_label"><i class="ti ti-send me-2 text-primary"></i> Send Test Email</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="form_test_email">
                    <div id="test_email_alert" class="alert d-none" role="alert"></div>
                    <div class="row align-items-center mb-3">
                        <div class="col-md-4">
                            <label class="form-label mb-md-0" for="test_recipient_email">Recipient <span class="color-red">*</span></label>
                        </div>
                        <div class="col-md-8">
                            <input type="email" class="form-control" id="test_recipient_email" name="test_recipient_email" placeholder="recipient@example.com">
                            <div class="invalid-feedback" id="error_msg_test_recipient_email"></div>
                        </div>
                    </div>
                    <div class="row align-items-center mb-3">
                        <div class="col-md-4">
                            <label class="form-label mb-md-0" for="test_email_subject">Subject <span class="color-red">*</span></label>
                        </div>
                        <div class="col-md-8">
                            <input type="text" class="form-control" id="test_email_subject" name="test_email_subject" value="Test Email from {{.ConfigData.AppName}}">
                            <div class="invalid-feedback" id="error_msg_test_email_subject"></div>
                        </div>
                    </div>
                    <div class="row align-items-start mb-3">
                        <div class="col-md-4">
                            <label class="form-label mb-md-0 pt-2" for="test_email_message">Message <span class="color-red">*</span></label>
                        </div>
                        <div class="col-md-8">
                            <textarea class="form-control" id="test_email_message" name="test_email_message" rows="3">This is a test email sent from the Admin Dashboard System Settings to verify email gateway connectivity.</textarea>
                            <div class="invalid-feedback" id="error_msg_test_email_message"></div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary d-inline-flex align-items-center" id="send_test_email_btn">
                    <i class="ti ti-send me-1"></i> Send Test Email
                </button>
            </div>
        </div>
    </div>
</div>

<script src="{{.ConfigData.AssetBaseUrl}}/assets/js/setting/email-settings.js"></script>