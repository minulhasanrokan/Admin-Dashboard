{{ template "include/breadcrumb" . }}
{{ template "settings/include/setting_menu" . }}
<div class="row" id="system-view">
    <div class="col-xl-3 theiaStickySidebar">
        <div class="card">
            <div class="card-body">
                <div class="d-flex flex-column list-group settings-list">
                    <a href="#" class="d-inline-flex align-items-center rounded active py-2 px-3 menu-link" data-url="{{.ConfigData.AppBaseUrl}}/settings/business-settings" data-title="Business Settings" data-parameter="" data-name="Business Settings" data-popup-status="0" data-popup-width="1000" data-content-div="content"><i class="ti ti-arrow-badge-right me-2"></i>Business Settings</a>
                    <a href="#" class="d-inline-flex align-items-center rounded py-2 px-3 menu-link" data-url="{{.ConfigData.AppBaseUrl}}/settings/images-settings" data-title="Images Settings" data-parameter="" data-name="Images Settings" data-popup-status="0" data-popup-width="1000" data-content-div="content">Images Settings</a>
                    <a href="#" class="d-inline-flex align-items-center rounded py-2 px-3 menu-link" data-url="{{.ConfigData.AppBaseUrl}}/settings/authentication-settings" data-title="Authentication Settings" data-parameter="" data-name="Authentication Settings" data-popup-status="0" data-popup-width="1000" data-content-div="content">Authentication Settings</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-9" id="system-edit-details">
        <div class="card">
            <div class="card-body">
                <div class="border-bottom mb-3 pb-3">
                    <h4>Business Settings</h4>
                </div>
                <form action="#" id="business-settings-form">
                    <div class="border-bottom mb-3">
                        <div class="row">
                            <div class="col-md-12">
                                <div>
                                    <h6 class="mb-3">Basic Information</h6>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="row align-items-center mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label mb-md-0" for="name">Name <span class="color-red">*</span></label>
                                    </div>
                                    <div class="col-md-8">
                                        <input tabindex="1" value="{{.SystemSetting.Name}}" type="text" name="name" id="name" minlength="5" maxlength="200" class="form-control">
                                        <div class="invalid-feedback" id="error_msg_name"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row align-items-center mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label mb-md-0" for="title">Title <span class="color-red">*</span></label>
                                    </div>
                                    <div class="col-md-8">
                                        <input tabindex="2" type="text" value="{{.SystemSetting.Title}}" name="title" id="title" minlength="5" maxlength="200" class="form-control">
                                        <div class="invalid-feedback" id="error_msg_title"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row align-items-center mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label mb-md-0" for="slogan">Slogan <span class="color-red">*</span></label>
                                    </div>
                                    <div class="col-md-8">
                                        <input tabindex="3" value="{{.SystemSetting.Slogan}}" type="text" name="slogan" id="slogan" minlength="5" maxlength="200" class="form-control">
                                        <div class="invalid-feedback" id="error_msg_slogan"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row align-items-center mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label mb-md-0" for="email">Email <span class="color-red">*</span></label>
                                    </div>
                                    <div class="col-md-8">
                                        <input tabindex="4" value="{{.SystemSetting.Email}}" type="text" name="email" id="email" minlength="5" maxlength="100" class="form-control">
                                        <div class="invalid-feedback" id="error_msg_email"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row align-items-center mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label mb-md-0" for="mobile">Mobile <span class="color-red">*</span></label>
                                    </div>
                                    <div class="col-md-8">
                                        <input tabindex="5" type="text" value="{{.SystemSetting.Mobile}}" name="mobile" id="mobile" minlength="11" maxlength="14" class="form-control">
                                        <div class="invalid-feedback" id="error_msg_mobile"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row align-items-center mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label mb-md-0" for="fax">Fax <span class="color-red">*</span></label>
                                    </div>
                                    <div class="col-md-8">
                                        <input tabindex="6" type="text" value="{{.SystemSetting.Fax}}" name="fax" id="fax" minlength="5" maxlength="200" class="form-control">
                                        <div class="invalid-feedback" id="error_msg_fax"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="border-bottom mb-3">
                        <h6 class="mb-3">Address Information</h6>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="row align-items-center mb-3">
                                    <div class="col-md-2">
                                        <label class="form-label mb-md-0" for="address">Address <span class="color-red">*</span></label>
                                    </div>
                                    <div class="col-md-10">
                                        <input tabindex="7" value="{{.SystemSetting.Address}}" type="text" name="address" id="address" minlength="5" maxlength="200" class="form-control">
                                        <div class="invalid-feedback" id="error_msg_address"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row align-items-center mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label mb-md-0" for="country">Country <span class="color-red">*</span></label>
                                        <input name="country_code" id="country_code" type="hidden" value="{{.SystemSetting.Country}}">
                                    </div>
                                    <div class="col-md-8">
                                        <div id="country_container">
                                            <select tabindex="8" class="select" name="country" id="country">
                                                <option value="">Select</option>
                                            </select>
                                        </div>
                                        <div class="invalid-feedback" id="error_msg_country"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row align-items-center mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label mb-md-0" for="state">State <span class="color-red">*</span></label>
                                        <input name="state_code" id="state_code" type="hidden" value="{{.SystemSetting.State}}">
                                    </div>
                                    <div class="col-md-8">
                                        <div id="state_container">
                                            <select tabindex="9" class="select" name="state" id="state">
                                                <option value="">Select</option>
                                            </select>
                                        </div>
                                        <div class="invalid-feedback" id="error_msg_state"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row align-items-center mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label mb-md-0" for="state">City <span class="color-red">*</span></label>
                                        <input name="city_code" id="city_code" type="hidden" value="{{.SystemSetting.City}}">
                                    </div>
                                    <div class="col-md-8">
                                        <div id="city_container">
                                            <select tabindex="10" class="select" name="city" id="city">
                                                <option value="">Select</option>
                                            </select>
                                        </div>
                                        <div class="invalid-feedback" id="error_msg_city"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row align-items-center mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label mb-md-0" for="post_code">Postal Code <span class="color-red">*</span></label>
                                    </div>
                                    <div class="col-md-8">
                                        <input tabindex="11" value="{{.SystemSetting.PostCode}}" minlength="4" maxlength="4" type="text" name="post_code" id="post_code" class="form-control">
                                        <div class="invalid-feedback" id="error_msg_post_code"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="row align-items-center mb-3">
                                    <div class="col-md-2">
                                        <label class="form-label mb-md-0" for="details">Details</label>
                                    </div>
                                    <div class="col-md-10">
                                        <input tabindex="12" type="text" value="{{.SystemSetting.Details}}" name="details" id="details" minlength="5" maxlength="500" class="form-control">
                                        <div class="invalid-feedback" id="error_msg_details"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="row align-items-center mb-3">
                                    <div class="col-md-2">
                                        <label class="form-label mb-md-0" for="version">Version <span class="color-red">*</span></label>
                                    </div>
                                    <div class="col-md-10">
                                        <input tabindex="13" type="text" value="{{.SystemSetting.Version}}" name="version" id="version" minlength="1" maxlength="500" class="form-control">
                                        <div class="invalid-feedback" id="error_msg_version"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="row align-items-center mb-3">
                                    <div class="col-md-2">
                                        <label class="form-label mb-md-0" for="copy_right">Copy Right <span class="color-red">*</span></label>
                                    </div>
                                    <div class="col-md-10">
                                        <input tabindex="14" type="text" value="{{.SystemSetting.CopyRight}}" name="copy_right" id="copy_right" minlength="1" maxlength="200" class="form-control">
                                        <div class="invalid-feedback" id="error_msg_copy_right"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-end">
                        <button tabindex="15" type="button" id="business_setting_button" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script src="{{.ConfigData.AssetBaseUrl}}/assets/js/setting/business-settings.js"></script>
